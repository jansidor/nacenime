# Skopíruj na backend/.env (súbor je v .gitignore). Nikdy necommituj kľúče.
# Cesta k cenníku. V produkcii MIMO verejného priečinka.
NACENIME_CENNIK_PATH=../design_handoff_nacenime/data/nacenime-cennik.json
# Cesta k SQLite databáze (priečinok musí byť zapisovateľný)
NACENIME_DB_PATH=var/nacenime.sqlite
# Typy nehnuteľností, pri ktorých sa rozpätie neukazuje (čiarkou oddelené), napr. Chata,Dom
NACENIME_TYPY_BEZ_ROZPATIA=
NACENIME_MAKLER_NAME=[MENO MAKLÉRA]
# Google Places API (New). Kľúč len na serveri.
NACENIME_GOOGLE_API_KEY=
# Denný strop volaní na Google (UTC). Po vyčerpaní beží záloha bez Google. 0 = bez stropu. Autocomplete aj detail adresy.
NACENIME_GOOGLE_DENNY_LIMIT=3000
# Limit požiadaviek na IP za minútu
NACENIME_RATE_LIMIT=60
NACENIME_TRUSTED_PROXY=0
NACENIME_RETENCIA_MESIACE=24
# SMTP pre e-maily s PDF (bin/odosli-pdf.php). Heslo len tu, nikdy v kóde.
NACENIME_SMTP_HOST=
NACENIME_SMTP_PORT=587
NACENIME_SMTP_SECURE=tls
NACENIME_SMTP_USER=
NACENIME_SMTP_PASS=
NACENIME_MAIL_FROM=noreply@nacenime.sk
