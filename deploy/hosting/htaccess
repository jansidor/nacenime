# Presmeruje /api/* na api.php (Apache). Nič iné nemení. Ak sa .htaccess ignoruje, pozri deploy/NASADENIE-GIT.md.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # www.nacenime.sk -> nacenime.sk (jedna adresa pre vyhľadávače)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
    RewriteRule ^api(/|$) api.php [L,QSA]
</IfModule>
